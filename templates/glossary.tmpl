{assign var='title' value='聖經詞彙'}
{include file="header.tmpl"}
<div class="page-body space-y-6" id="glossary-body">
  <div class="bg-white/80 dark:bg-slate-900 border border-amber-200/80 dark:border-slate-800 rounded-xl p-4 sm:p-6 shadow-sm">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div id="by-stroke" class="bg-amber-50/60 dark:bg-slate-800/60 border border-amber-200/70 dark:border-slate-700/80 rounded-xl p-4 transition-all">
        <div class="bg-white dark:bg-slate-800 border border-amber-300 dark:border-slate-700 rounded-lg py-2 px-4 text-center font-bold text-slate-800 dark:text-slate-100 shadow-sm mb-3">以筆畫查詢</div>
        <div id="by-stroke-list" class="flex flex-wrap gap-1.5 justify-center"></div>
      </div>
      <div id="by-alpha" class="bg-amber-50/60 dark:bg-slate-800/60 border border-amber-200/70 dark:border-slate-700/80 rounded-xl p-4 transition-all">
        <div class="bg-white dark:bg-slate-800 border border-amber-300 dark:border-slate-700 rounded-lg py-2 px-4 text-center font-bold text-slate-800 dark:text-slate-100 shadow-sm mb-3">以字母查詢</div>
        <div id="by-alpha-list" class="flex flex-wrap gap-1.5 justify-center"></div>
      </div>
    </div>
    
    <div id="glossary-index-header" class="glossary-index-header mt-6 pt-4 border-t border-amber-200 dark:border-slate-800 text-center text-lg font-bold text-amber-950 dark:text-amber-300 hidden"></div>
    <div id="glossary-index-container" class="mt-4 hidden">
      <div id="glossary-index-table" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5"></div>
    </div>
  </div>

  <div id="glossary-word-container" class="hidden"></div>
</div>
{include file="footer.tmpl"}


