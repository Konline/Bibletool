              <span class="font-bold text-lg tracking-wide text-amber-100 group-hover:text-white transition-colors">耶大雅聖經工具</span>
            </a>
          </div>

          <!-- Desktop Navigation Menu -->
          <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium">
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'static'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/static/about">緣由</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'browse'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/browse">經節查詢</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'interlinear'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/interlinear">聖經對照</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'query'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/query">字串查詢</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'calendar'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/calendar">每日讀經</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'outline'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/outline">聖經綱要</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'glossary'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/glossary">聖經詞彙</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'gospel'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/gospel">四福音書</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'biblemap'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/biblemap">聖經地圖</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'subjects'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/subjects">聖經主題</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'contactus'}bg-amber-700 text-white shadow-inner font-semibold{else}text-amber-100 hover:bg-amber-800/70 hover:text-white{/if}" href="{$webroot}/contactus">聯絡我們</a>
          </nav>

          <div class="flex items-center space-x-2">
            <!-- Dark Mode Toggle Button -->
            <button id="dark-mode-toggle" type="button" onclick="toggleDarkMode()" aria-label="Toggle Dark Mode" class="p-2 rounded-full text-amber-200 hover:text-white hover:bg-amber-800/60 focus:outline-none transition-colors">

              <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>


            <!-- Mobile Menu Toggle Button -->
            <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" aria-label="Open Mobile Menu" class="lg:hidden p-2 rounded-md text-amber-200 hover:text-white hover:bg-amber-800/60 focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4 pt-2 border-t border-amber-700/50">
          <div class="grid grid-cols-2 gap-1 text-sm font-medium">
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'static'}bg-amber-700 text-white{else}text-amber-100 hover:bg-amber-800/70{/if}" href="{$webroot}/static/about">緣由</a>
