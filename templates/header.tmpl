            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'subjects'}bg-amber-700 text-white{else}text-amber-100 hover:bg-amber-800/70{/if}" href="{$webroot}/subjects">聖經主題</a>
            <a class="px-3 py-2 rounded-md transition-colors {if $action == 'contactus'}bg-amber-700 text-white{else}text-amber-100 hover:bg-amber-800/70{/if}" href="{$webroot}/contactus">聯絡我們</a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

